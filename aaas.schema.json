{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json",
  "title": "AAAS 题库交换格式 v1",
  "description": "以单道题为基本单元。插件定义见同目录 *.schema.json，由 $ref 引用。字段含义见 HELP.md。",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/question" }
    }
  },
  "required": ["version", "questions"],
  "additionalProperties": false,
  "definitions": {
    "plugins": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "math.schema.json" },
          { "$ref": "chemistry.schema.json" },
          { "$ref": "photo.schema.json" },
          { "$ref": "excel.schema.json" }
        ]
      }
    },
    "numericAnswer": {
      "type": "object",
      "properties": {
        "value": { "type": "number" },
        "tol": { "type": "number", "minimum": 0 },
        "unit": { "type": "string" }
      },
      "required": ["value"],
      "additionalProperties": false
    },
    "answerChoose": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "enum": [""] },
        { "type": "integer", "minimum": 1 },
        {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true,
          "minItems": 1
        }
      ]
    },
    "answerBlank": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "enum": [""] },
        {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/numericAnswer" }
            ]
          }
        }
      ]
    },
    "answerJudge": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "enum": [""] },
        { "type": "boolean" }
      ]
    },
    "answerShort": {
      "anyOf": [
        { "type": "null" },
        { "type": "string" }
      ]
    },
    "regexPoint": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "point": { "type": "string" },
        "score": { "type": "number", "multipleOf": 0.5 }
      },
      "required": ["pattern"],
      "additionalProperties": false
    },
    "detailFields": {
      "type": "object",
      "properties": {
        "type": { "enum": ["choose", "blank", "judge", "short"] },
        "knowledge": { "anyOf": [ { "type": "null" }, { "type": "array", "items": { "type": "string" } } ] },
        "points": { "type": "number", "multipleOf": 0.5 },
        "stem": { "type": "string" },
        "answer": {},
        "scoring": { "enum": ["auto", "smart", "manual"] },
        "regex_points": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/regexPoint" } }
          ]
        },
        "standard_answer": { "type": ["string", "null"] },
        "rubric": { "type": ["string", "null"] }
      }
    },
    "answerBinding": {
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choose" } }, "required": ["type"] },
          "then": { "properties": { "answer": { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/answerChoose" } } }
        },
        {
          "if": { "properties": { "type": { "const": "blank" } }, "required": ["type"] },
          "then": { "properties": { "answer": { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/answerBlank" } } }
        },
        {
          "if": { "properties": { "type": { "const": "judge" } }, "required": ["type"] },
          "then": { "properties": { "answer": { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/answerJudge" } } }
        },
        {
          "if": { "properties": { "type": { "const": "short" } }, "required": ["type"] },
          "then": { "properties": { "answer": { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/answerShort" } } }
        }
      ]
    },
    "item": {
      "allOf": [
        { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/detailFields" },
        { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/answerBinding" }
      ]
    },
    "question": {
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$" },
        "revision": { "type": "integer", "minimum": 10 },
        "points": { "type": "number", "multipleOf": 0.5 },
        "instruction": { "type": "string" },
        "source": { "type": "string" },
        "plugins": { "anyOf": [ { "type": "null" }, { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/plugins" } ] },
        "number": { "type": "integer", "minimum": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/item" }
        },
        "type": { "enum": ["choose", "blank", "judge", "short"] },
        "knowledge": { "anyOf": [ { "type": "null" }, { "type": "array", "items": { "type": "string" } } ] },
        "stem": { "type": "string" },
        "answer": {},
        "scoring": { "enum": ["auto", "smart", "manual"] },
        "regex_points": {
          "anyOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/regexPoint" } }
          ]
        },
        "standard_answer": { "type": ["string", "null"] },
        "rubric": { "type": ["string", "null"] }
      },
      "required": ["subject", "authors", "date", "revision", "points", "instruction", "source"],
      "allOf": [
        { "$ref": "https://raw.githubusercontent.com/HelloZWH-0620/AAAS/main/aaas.schema.json#/definitions/answerBinding" },
        {
          "if": { "required": ["items"] },
          "then": {
            "not": { "anyOf": [{ "required": ["type"] }, { "required": ["stem"] }] }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
